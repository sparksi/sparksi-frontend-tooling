{
  "name": "@sparksi/frontend-tooling",
  "packageManager": "pnpm@8.15.4",
  "version": "1.0.17",
  "description": "Sparks Interactive frontend-tooling. A central place for opens source packages and tools.",
  "author": "Sparks Interactive <developers@sparksinteractive.co.nz>",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm --stream -r build",
    "tw": "pnpm --stream -r tw",
    "watch": "pnpm --stream -r watch:node",
    "prepare": "husky prepare",
    "qa": "stylelint {**,.,*/**,**/**/}*.pcss"
  },
  "keywords": [
    "stylelint",
    "stylelint-config",
    "eslint",
    "prettier"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.3.3",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "lint-staged": {
    "./public/themes/custom/**/*.ts": [
      "prettier --write"
    ],
    "public/themes/custom/*/*.pcss": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ]
  },
  "workspaces": [
    "/public/themes/custom/*",
    "/packages/*/*",
    "web/themes/custom/*"
  ]
}
